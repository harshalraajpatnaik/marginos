# ==========================================
# MarginOS Environment Configuration Template
# ==========================================

# Application
APP_NAME=MarginOS
APP_PORT=8080
APP_ENV=development
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:4200

# Database (PostgreSQL via Docker Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=marginos
POSTGRES_USER=marginos
POSTGRES_PASSWORD=marginos_secure_password_dev

# JWT Security
JWT_SECRET=4f8b9c2a1e6d7f0a8b9c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_SECONDS=604800

# Mail (Mailpit in Docker Compose)
MAIL_HOST=localhost
MAIL_PORT=1026
MAIL_FROM=no-reply@marginos.internal

# AI Assistant Layer (LM Studio or OpenAI compatible endpoint)
# AI is disabled by default - application works 100% deterministically without it
AI_ENABLED=false
AI_PROVIDER=lm-studio
AI_BASE_URL=http://localhost:1234/v1
AI_MODEL=qwen2.5-7b-instruct
AI_TIMEOUT_SECONDS=30

# Integration (Optional)
RABBITMQ_ENABLED=false
